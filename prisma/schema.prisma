generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Um colaborador da agência, do ponto de vista do Departamento Pessoal.
///
/// Todas as datas são texto "aaaa-mm-dd", e não DateTime: o servidor roda em
/// UTC, e uma data sem hora vira o dia anterior com facilidade. Aniversário e
/// vencimento de ASO são exatamente o tipo de coisa que não pode escorregar
/// um dia.
model Colaborador {
  id     String  @id @default(cuid())
  nome   String
  setor  String?
  cargo  String?
  ativo  Boolean @default(true)

  nascimento String?
  admissao   String?

  /// Último exame periódico e de quantos em quantos meses ele vence.
  asoUltimo String?
  asoMeses  Int     @default(12)

  /// Contrato sem banco de horas fica fora do Controle de Horas, mas continua
  /// no resto (férias, ASO, holerite).
  controlaHoras Boolean @default(true)

  /// Fica fora de todos os processos do DP (VA, VT, salário, holerite, horas,
  /// horários, ASO, férias) e só aparece em Aniversariantes. Ex.: a dona.
  foraDosProcessos Boolean @default(false)

  /// Jornada contratada: observação curta + os horários em dois blocos
  /// (segunda a sexta e sábado). Só informativo — quem calcula hora
  /// trabalhada é o sistema de ponto.
  jornada        String?
  jornadaDetalhe Json?

  /// Saldo do banco de horas copiado do relatório do ponto, e a data dele.
  /// O site continua a conta a partir daqui; nunca refaz a conta do ponto.
  saldoInicialMinutos Int     @default(0)
  saldoInicialEm      String?

  observacao String?

  lancamentos LancamentoHoras[]
  ferias      Ferias[]
  holerites   Holerite[]
  beneficios  Beneficio[]
  recargas    RecargaBeneficio[]
  planoVidas  PlanoVida[]
  premios     Premio[]
  planoMeses  PlanoMes[]
  salarios    Salario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nome])
}

/// Um movimento no banco de horas, em MINUTOS com sinal (negativo = devendo).
/// Minuto e não hora decimal: 03:47 em decimal é 3,7833… e perde um pedaço a
/// cada soma, num número que se confere batendo com o relatório do ponto.
model LancamentoHoras {
  id            String      @id @default(cuid())
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  data    String
  minutos Int
  motivo  String?

  createdAt DateTime @default(now())

  @@index([colaboradorId])
}

/// Um período de férias tirado (ou marcado), do primeiro ao último dia.
model Ferias {
  id            String      @id @default(cuid())
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  inicio     String
  fim        String
  observacao String?

  createdAt DateTime @default(now())

  @@index([colaboradorId])
}

/// A entrega do holerite de uma competência ("2026-10") a um colaborador.
/// Existir o registro com `entregueEm` preenchido = entregue.
model Holerite {
  id            String      @id @default(cuid())
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  competencia String
  entregueEm  String?

  createdAt DateTime @default(now())

  @@unique([colaboradorId, competencia])
}

/* ─── Dinheiro ───
   Todo valor em dinheiro é guardado em CENTAVOS, inteiro. R$ 8,80 = 880.
   Número com vírgula no banco erra o centavo na soma (0,1 + 0,2 ≠ 0,3), e
   aqui a soma é conferida com o extrato. */

/// Salário a partir de uma data. O atual é o mais recente que já começou;
/// os anteriores ficam como histórico de reajustes.
model Salario {
  id            String      @id @default(cuid())
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  valorCentavos Int
  desde         String
  motivo        String?

  createdAt DateTime @default(now())

  @@index([colaboradorId])
}

/// Quem recebe VA ou VT, e quanto. Existir a linha = recebe.
model Beneficio {
  id            String      @id @default(cuid())
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  /// "va" ou "vt"
  tipo          String
  valorCentavos Int
  /// true: o valor é por dia trabalhado. false: é o valor do mês cheio.
  porDia        Boolean @default(true)
  /// Quantas vezes o valor entra por dia: no VT, passagens por dia (ida e
  /// volta = 2). 1 nos registros antigos, em que o valor já era o do dia.
  vezesPorDia   Int     @default(1)

  @@unique([colaboradorId, tipo])
}

/// A recarga de um mês para um colaborador: dias considerados e se já foi feita.
model RecargaBeneficio {
  id            String      @id @default(cuid())
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  tipo        String
  competencia String
  /// null = os dias úteis do mês, sem desconto.
  dias        Int?
  /// VA: sábados trabalhados no período — cada um soma meio dia.
  sabados     Int?
  /// VA: dias a descontar (falta, atestado, declaração). Aceita meio dia.
  descontar   Float?
  motivo      String?
  carregadoEm String?
  /// O valor no momento em que foi marcada como carregada.
  valorCentavos Int?

  @@unique([colaboradorId, tipo, competencia])
}

/// Dias úteis de um mês, quando diferente da conta automática (feriado etc.).
model MesBeneficio {
  tipo        String
  competencia String
  diasUteis   Int

  @@id([tipo, competencia])
}

/// Uma pessoa no plano de saúde: o titular ou um dependente.
/// Saiu do plano = `exclusao` preenchida; a linha fica como histórico.
model PlanoVida {
  id            String      @id @default(cuid())
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  /// "Titular", "Cônjuge", "Filho(a)"...
  parentesco    String
  /// Vazio para o titular (usa o nome do colaborador).
  nome          String?
  nascimento    String?
  plano         String?
  carteirinha   String?
  valorCentavos    Int?
  descontoCentavos Int?
  inclusao      String?
  exclusao      String?
  observacao    String?

  createdAt DateTime @default(now())

  @@index([colaboradorId])
}

/// A fatura do plano num mês, por titular: o que ele usou (consultas e
/// exames, só desconta se usar) e se já foi lançado na folha. Ao lançar,
/// guarda os valores daquela hora — a mensalidade pode ter reajuste depois.
model PlanoMes {
  id            String      @id @default(cuid())
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  /// aaaa-mm da fatura. O desconto vai na folha do mês seguinte.
  competencia String
  consultasCentavos Int?
  observacao  String?
  lancadoEm   String?
  empresaCentavos     Int?
  colaboradorCentavos Int?

  @@unique([colaboradorId, competencia])
}

/// Assinatura ganha como prêmio de meta (Spotify, HBO...).
model Premio {
  id            String      @id @default(cuid())
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  competencia String
  servico     String
  observacao  String?
  ativadoEm   String?

  createdAt DateTime @default(now())

  @@index([competencia])
}

/// Freelancer (coletor, limpeza). Não é colaborador registrado.
model Freelancer {
  id     String  @id @default(cuid())
  nome   String
  funcao String?
  telefone String?
  pix      String?
  diariaCentavos Int?
  observacao String?
  /// Para lembrar do aniversário dos freelas também.
  nascimento String?
  ativo  Boolean @default(true)

  diarias Diaria[]

  createdAt DateTime @default(now())
}

/// Um dia trabalhado por um freelancer. Pago = `pagoEm` preenchido.
model Diaria {
  id           String     @id @default(cuid())
  freelancerId String
  freelancer   Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  data          String
  valorCentavos Int
  observacao    String?
  pagoEm        String?

  createdAt DateTime @default(now())

  @@index([freelancerId])
}

/// Um compromisso da agenda do DP (prazo, rotina). Veio da agenda dos setores
/// do Portal; a regra de dia útil (seg a sex, sem feriado) fica em lib/agenda.
model ItemAgenda {
  id         String  @id @default(cuid())
  titulo     String
  observacao String?

  /// DIAS_UTEIS, SEMANAL, MENSAL, MENSAL_SEMANA ou UNICA
  frequencia  String
  diaSemana   Int?
  diaMes      Int?
  semanaDoMes Int?
  dataUnica   String?
  intervaloMeses Int  @default(1)
  mesBase        Int?

  ativo Boolean @default(true)

  feitos AgendaFeito[]

  createdAt DateTime @default(now())
}

/// Uma ocorrência marcada como feita. Não ter a linha = a fazer (ou atrasada).
model AgendaFeito {
  id     String     @id @default(cuid())
  itemId String
  item   ItemAgenda @relation(fields: [itemId], references: [id], onDelete: Cascade)

  /// O dia em que a ocorrência era devida, aaaa-mm-dd.
  data      String
  createdAt DateTime @default(now())

  @@unique([itemId, data])
}
